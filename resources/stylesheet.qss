* {
    background-color: #1A1D22;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #1A1D22;
    color: #FFFFFF;
    border: none;
    border-right: 1px solid #596273;
    border-bottom: 1px solid #596273;
    padding: 3px 6px;
}

QPlainTextEdit {
    background-color: #282C34;
    border: 1px solid #596273;
}

QLabel {
    color: #FFFFFF;
}

QAbstractItemView {
    background-color: #282C34;
    color: #FFFFFF;
}

QLineEdit {
    background-color: #282C34;
    color: #FFFFFF;
    border: 1px solid #596273;
}

QPushButton {
    background-color: #282C34;
    color: #FFFFFF;
}

QPushButton:hover {
    background-color: #596273;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #596273;
}

QCheckBox::indicator:unchecked {
    background-color: #282C34;
}

QCheckBox::indicator:checked {
    background-color: #4a708b;
}

QComboBox {
    background-color: #282C34;
    color: #FFFFFF;
    border: 1px solid #596273;
}

QComboBox QAbstractItemView {
    background-color: #282C34;
    color: #FFFFFF;
}

QMessageBox {
    background-color: #1A1D22;
    color: #FFFFFF;
}

QProgressBar {
        border: 0px solid #596273;
        text-align: center;
        background-color: #282C34;
        color: #FFFFFF;
}
QProgressBar::chunk {
    background-color: #4a708b;
}


QScrollBar {
    background: #1A1D22;
    border: 2px #FFFFFF;
}
QScrollBar::handle {
    background: #4a708b;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

QFrame[frameShape="4"] {
    background-color: #596273;
}